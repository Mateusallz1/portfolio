---
import type { CollectionEntry } from 'astro:content';
import { toCleanMusicSlug } from '../data/musicTracks';

interface Props {
  lesson: CollectionEntry<'music'>;
}

const { lesson } = Astro.props;
const {
  title,
  description,
  track,
  lessonNumber,
  level,
  practiceTime,
  readingTime,
  tags,
} = lesson.data;

const cleanSlug = toCleanMusicSlug(lesson.id);
const transitionKey = cleanSlug.replace(/\//g, '-');
const lessonUrl = `/pt/musica/${cleanSlug}`;
const unitLabel = track === 'contrabaixo' ? 'Aula' : 'Módulo';
const formattedNumber = String(lessonNumber).padStart(2, '0');
---

<article class="border-t border-base-content/15 pt-5 pb-2 group min-w-0">
  <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-base-content/60 mb-2.5">
    <span class="font-bold text-primary">
      {unitLabel} {formattedNumber}
    </span>
    <span>·</span>
    <span class="badge badge-xs badge-ghost font-mono text-[11px]">
      {level}
    </span>
    <span>·</span>
    <span>{readingTime} de leitura</span>
    {practiceTime && (
      <>
        <span>·</span>
        <span>{practiceTime} de prática</span>
      </>
    )}
  </div>

  <h3 class="text-base sm:text-lg font-semibold text-base-content mb-2 leading-snug break-words">
    <a
      href={lessonUrl}
      data-astro-prefetch="hover"
      class="hover:underline transition-colors"
      transition:name={`music-title-${transitionKey}`}
    >
      {title}
    </a>
  </h3>

  <p class="text-sm text-base-content/75 leading-relaxed mb-3 break-words">
    {description}
  </p>

  <p class="text-xs font-mono text-base-content/45 break-words">
    {tags.map((t) => `#${t}`).join('  ')}
  </p>
</article>
