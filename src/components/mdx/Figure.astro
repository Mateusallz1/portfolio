---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  aspectRatio?: '16/9' | '4/3' | 'auto';
  bleed?: boolean;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  aspectRatio = 'auto',
  bleed = false,
  loading = 'lazy',
} = Astro.props;

const isMetadata = typeof src === 'object';
---

<figure class:list={['my-8 not-prose max-w-full', bleed && '-mx-4 sm:-mx-6 md:-mx-8']}>
  <div
    class:list={[
      'overflow-hidden border border-base-content/15 bg-base-200/40 transition-colors max-w-full',
      bleed ? 'rounded-none sm:rounded-lg border-x-0 sm:border-x' : 'rounded-lg',
    ]}
  >
    {
      isMetadata ? (
        <Image
          src={src as ImageMetadata}
          alt={alt}
          loading={loading}
          class:list={[
            'w-full h-auto max-w-full object-cover transition-opacity duration-300',
            aspectRatio === '16/9' && 'aspect-[16/9]',
            aspectRatio === '4/3' && 'aspect-[4/3]',
          ]}
        />
      ) : (
        <img
          src={src as string}
          alt={alt}
          loading={loading}
          class:list={[
            'w-full h-auto max-w-full object-cover transition-opacity duration-300',
            aspectRatio === '16/9' && 'aspect-[16/9]',
            aspectRatio === '4/3' && 'aspect-[4/3]',
          ]}
        />
      )
    }
  </div>

  {
    caption && (
      <figcaption class="mt-2.5 px-2 text-center text-xs font-mono text-base-content/60 tracking-tight break-words">
        ▲ {caption}
      </figcaption>
    )
  }
</figure>
