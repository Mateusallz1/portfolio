---
import { profile } from '../data/profile';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-base-content/10 bg-base-100 mt-20 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-10 sm:py-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <!-- Status / Info -->
    <div class="flex flex-col items-start gap-1.5">
      <div class="flex items-center gap-2 text-xs font-mono text-base-content/70">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>{profile.availability[lang]}</span>
      </div>
      <p class="text-xs text-base-content/50 font-mono">
        Teresina - PI, Brasil · {lang === 'pt' ? 'Trabalho 100% Remoto' : '100% Remote Available'}
      </p>
    </div>

    <!-- Social links -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono">
      <a
        href={profile.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-base-content/70 hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        GitHub
      </a>

      <a
        href={`mailto:${profile.email}`}
        class="text-base-content/70 hover:text-primary transition-colors flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Email
      </a>

      <a
        href="/rss.xml"
        class="text-base-content/70 hover:text-amber-500 transition-colors flex items-center gap-1"
        title="RSS Feed"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="6.18" cy="17.82" r="2.18" />
          <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
        </svg>
        RSS
      </a>

      {lang === 'pt' && (
        <a
          href={profile.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-emerald-500 hover:text-emerald-400 transition-colors flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 2C6.518 2 2.032 6.485 2.032 12.001c0 1.954.561 3.845 1.625 5.467L2 22l4.67-1.611a9.98 9.98 0 005.361 1.612h.004c5.513 0 10-4.486 10-10.002 0-5.516-4.487-10-10.004-10zm0 18.293a8.27 8.27 0 01-4.223-1.157l-.303-.18-3.138 1.082 1.098-3.06-.197-.314a8.274 8.274 0 01-1.267-4.663c0-4.57 3.719-8.288 8.29-8.288 4.57 0 8.289 3.718 8.289 8.288 0 4.57-3.719 8.288-8.289 8.288z"/>
          </svg>
          WhatsApp
        </a>
      )}
    </div>
  </div>

  <div class="border-t border-base-content/5 py-4 px-4 text-center text-[11px] text-base-content/50 font-mono">
    © {currentYear} Mateus Alves · Built with Astro, TypeScript, Tailwind CSS & uv.
  </div>
</footer>
