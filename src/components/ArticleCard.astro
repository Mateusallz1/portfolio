---
interface Props {
  article: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      readingTime: string;
      tags: string[];
      lang: 'pt' | 'en';
    };
  };
  lang: 'pt' | 'en';
}

const { article, lang } = Astro.props;
const { title, description, pubDate, readingTime, tags } = article.data;

const formattedDate = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(new Date(pubDate));

const cleanSlug = article.id.replace(/^(pt\/|en\/)/, '');
const articleUrl = `/${lang}/blog/${cleanSlug}`;
---

<article class="border-t border-base-content/15 pt-6 pb-2 group">
  <div class="flex items-center gap-3 text-xs font-mono text-base-content/50 mb-2">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span>·</span>
    <span>{readingTime}</span>
  </div>

  <h3 class="text-base sm:text-lg font-semibold text-base-content mb-2 leading-snug">
    <a
      href={articleUrl}
      class="hover:underline transition-colors"
      transition:name={`article-title-${cleanSlug}`}
    >
      {title}
    </a>
  </h3>

  <p class="text-sm text-base-content/75 leading-relaxed mb-3">
    {description}
  </p>

  <p class="text-xs font-mono text-base-content/40">
    {tags.map((t) => `#${t}`).join('  ')}
  </p>
</article>
