---
interface Props {
  article: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      readingTime: string;
      tags: string[];
      lang: 'pt' | 'en';
    };
  };
  lang: 'pt' | 'en';
}

const { article, lang } = Astro.props;
const { title, description, pubDate, readingTime, tags } = article.data;

const formattedDate = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(new Date(pubDate));

// Clean slug calculation for URL
const cleanSlug = article.id.replace(/^(pt\/|en\/)/, '');
const articleUrl = `/${lang}/blog/${cleanSlug}`;
---

<a
  href={articleUrl}
  class="glass-panel glow-hover rounded-xl p-5 flex flex-col justify-between transition-colors group block border border-base-content/10"
>
  <div>
    <div class="flex items-center gap-3 text-xs font-mono text-base-content/60 mb-2">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <span>{readingTime}</span>
    </div>

    <h3 class="text-base font-bold text-base-content group-hover:text-primary transition-colors mb-2">
      {title}
    </h3>

    <p class="text-xs text-base-content/75 line-clamp-2 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-base-content/10">
    {tags.map((tag) => (
      <span class="badge badge-xs badge-ghost font-mono text-[10px]">
        #{tag}
      </span>
    ))}
  </div>
</a>
