---
interface Props {
  note: {
    id: string;
    data: {
      title: string;
      pubDate: Date;
      category: string;
      tags: string[];
      lang: 'pt' | 'en';
    };
  };
  lang: 'pt' | 'en';
}

const { note, lang } = Astro.props;
const { title, pubDate, category, tags } = note.data;

const formattedDate = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-US', {
  month: 'short',
  day: 'numeric',
}).format(new Date(pubDate));

const cleanSlug = note.id.replace(/^(pt\/|en\/)/, '');
const noteUrl = `/${lang}/${lang === 'pt' ? 'notas' : 'notes'}/${cleanSlug}`;
---

<a
  href={noteUrl}
  data-astro-prefetch="hover"
  class="py-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 sm:gap-2 border-b border-base-content/10 group transition-colors min-w-0"
>
  <div class="flex items-baseline gap-2 sm:gap-3 min-w-0">
    <span class="text-xs font-mono text-base-content/50 shrink-0">
      [{category}]
    </span>
    <span
      class="text-sm font-medium text-base-content group-hover:underline break-words min-w-0"
      transition:name={`note-title-${cleanSlug}`}
    >
      {title}
    </span>
  </div>

  <time datetime={pubDate.toISOString()} class="text-xs font-mono text-base-content/40 shrink-0">
    {formattedDate}
  </time>
</a>
