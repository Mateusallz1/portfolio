---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      lang: 'pt' | 'en';
      role: string;
      techs: string[];
      metrics?: string[];
      githubUrl?: string;
      liveUrl?: string;
    };
  };
  lang: 'pt' | 'en';
}

const { project, lang } = Astro.props;
const { title, description, role, techs, metrics, githubUrl, liveUrl } = project.data;
---

<div class="border-t border-base-content/15 pt-6 flex flex-col justify-between group">
  <div>
    <!-- Role and Links -->
    <div class="flex items-center justify-between gap-4 mb-2">
      <span class="text-xs font-mono text-base-content/60 uppercase tracking-wider">
        {role}
      </span>
      <div class="flex items-center gap-3">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-base-content/60 hover:text-base-content transition-colors flex items-center gap-1"
          >
            GitHub ↗
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-base-content/60 hover:text-base-content transition-colors flex items-center gap-1"
          >
            Demo ↗
          </a>
        )}
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-base-content mb-3 leading-snug">
      {title}
    </h3>
    
    <p class="text-sm text-base-content/80 leading-relaxed mb-5">
      {description}
    </p>

    <!-- Metrics (STAR Result Proof) -->
    {metrics && metrics.length > 0 && (
      <div class="mb-5 pl-4 border-l border-base-content/20 space-y-1.5">
        <span class="text-[11px] font-mono uppercase tracking-wider text-base-content/50 block font-semibold mb-1">
          {lang === 'pt' ? 'Resultados Mensurados:' : 'Key Metrics:'}
        </span>
        <ul class="space-y-1 text-xs text-base-content/80 leading-relaxed">
          {metrics.map((metric) => (
            <li class="flex items-start gap-2">
              <span class="text-base-content/40 select-none">—</span>
              <span>{metric}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Tech tags -->
  <p class="text-xs font-mono text-base-content/50 pt-2">
    {techs.join(' · ')}
  </p>
</div>
