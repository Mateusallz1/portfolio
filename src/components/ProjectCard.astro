---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      lang: 'pt' | 'en';
      role: string;
      techs: string[];
      metrics?: string[];
      githubUrl?: string;
      liveUrl?: string;
    };
  };
  lang: 'pt' | 'en';
}

const { project, lang } = Astro.props;
const { title, description, role, techs, metrics, githubUrl, liveUrl } = project.data;
---

<div class="glass-panel glow-hover rounded-xl p-6 flex flex-col justify-between transition-colors group">
  <div>
    <!-- Header with Role & Links -->
    <div class="flex items-start justify-between gap-4 mb-3">
      <span class="text-xs font-mono font-medium text-primary px-2 py-0.5 rounded bg-primary/10 border border-primary/20">
        {role}
      </span>
      <div class="flex items-center gap-2">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-base-content/60 hover:text-primary transition-colors"
            title="GitHub Repository"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-1 text-base-content/60 hover:text-primary transition-colors"
            title="Live Demo / Details"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- Title & Description -->
    <h3 class="text-lg font-bold tracking-tight text-base-content group-hover:text-primary transition-colors mb-2">
      {title}
    </h3>
    <p class="text-sm text-base-content/75 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Metrics (STAR Result Proof) -->
    {metrics && metrics.length > 0 && (
      <div class="mb-4 bg-base-300/40 rounded-lg p-3 border border-base-content/10">
        <span class="text-[11px] font-mono uppercase tracking-wider text-base-content/50 block mb-1.5 font-semibold">
          {lang === 'pt' ? 'Impacto & Resultados:' : 'Key Metrics & Impact:'}
        </span>
        <ul class="space-y-1 text-xs text-base-content/85">
          {metrics.map((metric) => (
            <li class="flex items-start gap-1.5">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{metric}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Tech tags -->
  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-base-content/10">
    {techs.map((tech) => (
      <span class="badge badge-sm badge-ghost font-mono text-[11px]">
        {tech}
      </span>
    ))}
  </div>
</div>
