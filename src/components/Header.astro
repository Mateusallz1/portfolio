---
import SearchModal from './SearchModal.astro';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

// Determine current URL path
const pathname = Astro.url.pathname;

// Generate corresponding target link for switching language
let switchLangUrl = lang === 'pt' ? '/en' : '/pt';
if (pathname.includes('/blog')) {
  switchLangUrl = lang === 'pt' ? '/en/blog' : '/pt/blog';
} else if (pathname.includes('/notas') || pathname.includes('/notes')) {
  switchLangUrl = lang === 'pt' ? '/en/notes' : '/pt/notas';
} else if (pathname.includes('/projetos') || pathname.includes('/projects')) {
  switchLangUrl = lang === 'pt' ? '/en/projects' : '/pt/projetos';
}

const navLinks = lang === 'pt'
  ? [
      { name: 'Início', href: '/pt' },
      { name: 'Projetos', href: '/pt/projetos' },
      { name: 'Serviços', href: '/pt/servicos' },
      { name: 'Blog', href: '/pt/blog' },
      { name: 'Notas', href: '/pt/notas' },
    ]
  : [
      { name: 'Home', href: '/en' },
      { name: 'Projects', href: '/en/projects' },
      { name: 'Resume', href: '/en/resume' },
      { name: 'Blog', href: '/en/blog' },
      { name: 'Notes', href: '/en/notes' },
    ];
---

<header class="sticky top-0 z-50 w-full bg-base-100 border-b border-base-content/10 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-2">
    <!-- Brand / Logo -->
    <a href={lang === 'pt' ? '/pt' : '/en'} data-astro-prefetch="hover" class="flex items-center gap-2 group min-w-0">
      <span class="font-mono font-bold text-sm tracking-tight text-base-content shrink-0">M/A</span>
      <span class="text-base-content/30 font-mono text-xs shrink-0">/</span>
      <span class="text-xs text-base-content/70 font-mono truncate max-w-[110px] sm:max-w-none">Mateus Alves</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/pt' && link.href !== '/en' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            data-astro-prefetch="hover"
            class:list={[
              'px-3 py-1.5 text-xs font-medium rounded-md transition-colors',
              isActive
                ? 'bg-base-200 text-base-content font-semibold border border-base-content/15'
                : 'text-base-content/70 hover:text-base-content hover:bg-base-200/50',
            ]}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Actions (Search, Language, Theme, Mobile toggle) -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Search Trigger & Modal -->
      <SearchModal lang={lang} />

      <!-- Language Switcher Pill -->
      <a
        href={switchLangUrl}
        data-astro-prefetch="hover"
        class="btn btn-ghost btn-xs font-mono text-[11px] border border-base-content/15 hover:border-primary/40 px-2"
        title={lang === 'pt' ? 'Mudar para Inglês' : 'Switch to Portuguese'}
      >
        <span class={lang === 'pt' ? 'text-primary font-bold' : 'text-base-content/50'}>PT</span>
        <span class="text-base-content/30">/</span>
        <span class={lang === 'en' ? 'text-primary font-bold' : 'text-base-content/50'}>EN</span>
      </a>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle"
        class="btn btn-ghost btn-square btn-xs border border-base-content/15 text-base-content/70 hover:text-base-content"
        aria-label="Toggle theme"
      >
        <!-- Sun icon -->
        <svg id="theme-sun" class="w-3.5 h-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon -->
        <svg id="theme-moon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-trigger"
        type="button"
        class="btn btn-ghost btn-square btn-xs border border-base-content/15 md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <!-- Hamburger icon -->
        <svg id="mobile-menu-hamburger" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close (X) icon -->
        <svg id="mobile-menu-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Drops down directly below sticky header) -->
  <div
    id="mobile-menu-drawer"
    class="fixed inset-x-0 top-16 bottom-0 z-40 hidden md:hidden bg-black/60 backdrop-blur-sm transition-all"
    role="dialog"
    aria-modal="true"
    aria-label={lang === 'pt' ? 'Menu de navegação móvel' : 'Mobile navigation menu'}
  >
    <div
      id="mobile-menu-panel"
      class="w-full bg-base-100 border-b border-base-content/15 shadow-2xl p-5 flex flex-col gap-4 animate-in slide-in-from-top duration-200"
    >
      <nav class="flex flex-col space-y-1">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/pt' && link.href !== '/en' && pathname.startsWith(link.href));
          return (
            <a
              href={link.href}
              data-astro-prefetch="tap"
              class:list={[
                'px-4 py-3 rounded-lg text-sm font-medium transition-colors flex items-center justify-between',
                isActive
                  ? 'bg-base-200 text-base-content font-bold border border-base-content/15'
                  : 'text-base-content/75 hover:bg-base-200/60 hover:text-base-content',
              ]}
            >
              <span>{link.name}</span>
              {isActive ? (
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
              ) : (
                <span class="text-base-content/30 text-xs font-mono">→</span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Language Switcher in Drawer -->
      <div class="pt-4 border-t border-base-content/10 flex items-center justify-between text-xs font-mono">
        <span class="text-base-content/50">Idioma / Language:</span>
        <a
          href={switchLangUrl}
          data-astro-prefetch="hover"
          class="btn btn-ghost btn-xs font-mono border border-base-content/15"
        >
          {lang === 'pt' ? 'Mudar para Inglês (EN) ↗' : 'Switch to Portuguese (PT) ↗'}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeaderScripts() {
    // 1. Theme toggle
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-sun');
    const moonIcon = document.getElementById('theme-moon');

    function updateThemeIcons(theme: string) {
      if (theme === 'light') {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    updateThemeIcons(currentTheme);

    themeToggle?.addEventListener('click', () => {
      const activeTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', activeTheme);
      localStorage.setItem('theme', activeTheme);
      updateThemeIcons(activeTheme);
    });

    // 2. Mobile Menu Drawer
    const menuTrigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('mobile-menu-hamburger');
    const closeIcon = document.getElementById('mobile-menu-close');

    if (!menuTrigger || !drawer) return;

    function openMenu() {
      drawer?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      menuTrigger?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      drawer?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menuTrigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    }

    menuTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !drawer.classList.contains('hidden');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Tap outside (on backdrop) to close
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) {
        closeMenu();
      }
    });

    // Close when tapping any link
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        closeMenu();
      }
    });
  }

  // Initial load
  setupHeaderScripts();

  // On View Transition navigation
  document.addEventListener('astro:after-swap', setupHeaderScripts);
</script>
