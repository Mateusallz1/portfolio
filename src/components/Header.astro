---
interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;

// Determine current URL path
const pathname = Astro.url.pathname;

// Generate corresponding target link for switching language
let switchLangUrl = lang === 'pt' ? '/en' : '/pt';
if (pathname.includes('/blog')) {
  switchLangUrl = lang === 'pt' ? '/en/blog' : '/pt/blog';
} else if (pathname.includes('/notas') || pathname.includes('/notes')) {
  switchLangUrl = lang === 'pt' ? '/en/notes' : '/pt/notas';
} else if (pathname.includes('/projetos') || pathname.includes('/projects')) {
  switchLangUrl = lang === 'pt' ? '/en/projects' : '/pt/projetos';
}

const navLinks = lang === 'pt'
  ? [
      { name: 'Início', href: '/pt' },
      { name: 'Projetos', href: '/pt/projetos' },
      { name: 'Serviços', href: '/pt/servicos' },
      { name: 'Blog', href: '/pt/blog' },
      { name: 'Notas', href: '/pt/notas' },
    ]
  : [
      { name: 'Home', href: '/en' },
      { name: 'Projects', href: '/en/projects' },
      { name: 'Resume', href: '/en/resume' },
      { name: 'Blog', href: '/en/blog' },
      { name: 'Notes', href: '/en/notes' },
    ];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-base-100/80 border-b border-base-content/10 transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href={lang === 'pt' ? '/pt' : '/en'} class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-neutral text-neutral-content flex items-center justify-center font-mono font-bold text-sm border border-base-content/20 group-hover:border-primary/50 transition-colors">
        M
      </div>
      <div class="flex flex-col">
        <span class="font-semibold text-sm tracking-tight group-hover:text-primary transition-colors">Mateus Alves</span>
        <span class="text-[10px] text-base-content/60 font-mono -mt-1">Software Engineer</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/pt' && link.href !== '/en' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              'px-3 py-1.5 text-xs font-medium rounded-md transition-colors',
              isActive
                ? 'bg-base-200 text-base-content font-semibold border border-base-content/15'
                : 'text-base-content/70 hover:text-base-content hover:bg-base-200/50',
            ]}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Actions (Language, Theme, Mobile toggle) -->
    <div class="flex items-center gap-2">
      <!-- Language Switcher Pill -->
      <a
        href={switchLangUrl}
        class="btn btn-ghost btn-xs font-mono text-[11px] border border-base-content/15 hover:border-primary/40 px-2"
        title={lang === 'pt' ? 'Mudar para Inglês' : 'Switch to Portuguese'}
      >
        <span class={lang === 'pt' ? 'text-primary font-bold' : 'text-base-content/50'}>PT</span>
        <span class="text-base-content/30">/</span>
        <span class={lang === 'en' ? 'text-primary font-bold' : 'text-base-content/50'}>EN</span>
      </a>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle"
        class="btn btn-ghost btn-square btn-xs border border-base-content/15 text-base-content/70 hover:text-base-content"
        aria-label="Toggle theme"
      >
        <!-- Sun icon -->
        <svg id="theme-sun" class="w-3.5 h-3.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon -->
        <svg id="theme-moon" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Dropdown -->
      <div class="dropdown dropdown-end md:hidden">
        <label tabindex="0" class="btn btn-ghost btn-square btn-xs border border-base-content/15" aria-label="Open menu">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <ul tabindex="0" class="dropdown menu menu-sm bg-base-200 border border-base-content/15 rounded-box z-50 mt-2 w-48 p-2 shadow-lg">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs font-medium">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  function setupTheme() {
    const toggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-sun');
    const moon = document.getElementById('theme-moon');

    function updateIcons(theme: string) {
      if (theme === 'light') {
        sun?.classList.remove('hidden');
        moon?.classList.add('hidden');
      } else {
        sun?.classList.add('hidden');
        moon?.classList.remove('hidden');
      }
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    updateIcons(currentTheme);

    toggle?.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme');
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateIcons(next);
    });
  }

  setupTheme();
  document.addEventListener('astro:after-swap', setupTheme);
</script>
