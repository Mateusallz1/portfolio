---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const lang = 'en';
const allProjects = await getCollection('projects');
const enProjects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`Projects & Case Studies · ${profile.name}`}
  description="Production software engineering projects built with Python, Django, uv, and TypeScript using the STAR framework."
  lang={lang}
>
  <div class="py-6 sm:py-10 border-b border-base-content/10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-mono mb-4">
      <span>Engineering Portfolio</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content">
      Case Studies & Projects
    </h1>
    <p class="mt-2 text-base text-base-content/75 max-w-2xl leading-relaxed">
      A collection of backend and fullstack systems engineered for durability, testability, and business impact.
    </p>
  </div>

  <div class="py-10 grid grid-cols-1 md:grid-cols-2 gap-6">
    {enProjects.map((project) => (
      <ProjectCard project={project} lang={lang} />
    ))}
  </div>
</BaseLayout>
