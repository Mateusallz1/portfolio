---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { profile } from '../../../data/profile';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((entry) => entry.data.lang === 'en')
    .map((entry) => ({
      params: { slug: entry.id.replace(/^(en\/)/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, pubDate, category, tags } = entry.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));
---

<BaseLayout
  title={`${title} · Notes by ${profile.name}`}
  description={`Engineering note on ${category}: ${title}`}
  lang="en"
>
  <div class="max-w-3xl mx-auto py-6">
    <a
      href="/en/notes"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-base-content/60 hover:text-primary transition-colors mb-6"
    >
      <span>←</span>
      Back to all notes
    </a>

    <header class="border-b border-base-content/10 pb-6 mb-6">
      <div class="flex items-center gap-3 text-xs font-mono text-base-content/60 mb-2">
        <span class="badge badge-sm badge-primary badge-soft">{category}</span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>

      <h1
        class="text-2xl sm:text-3xl font-bold tracking-tight text-base-content mb-3"
        transition:name={`note-title-${Astro.params.slug}`}
      >
        {title}
      </h1>

      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="badge badge-xs badge-ghost font-mono text-[10px]">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="prose dark:prose-invert max-w-none
      prose-p:text-base prose-p:leading-[1.75] prose-p:text-base-content/85 prose-p:mb-5
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content
      prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-base-content/10
      prose-h3:text-base sm:prose-h3:text-lg prose-h3:mt-7 prose-h3:mb-2
      prose-a:text-primary prose-a:underline-offset-4 hover:prose-a:underline
      prose-code:before:content-none prose-code:after:content-none
      prose-code:font-mono prose-code:text-[0.875em] prose-code:bg-base-200/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-transparent prose-pre:p-0 prose-pre:border-none prose-pre:my-5
      prose-blockquote:border-l-2 prose-blockquote:border-primary/60 prose-blockquote:italic prose-blockquote:text-base-content/80 prose-blockquote:bg-base-200/25 prose-blockquote:py-1 prose-blockquote:px-3.5 prose-blockquote:rounded-r prose-blockquote:my-5
      prose-ul:my-4 prose-li:my-1
      prose-img:rounded-lg prose-img:border prose-img:border-base-content/15 prose-img:my-6">
      <Content />
    </div>
  </div>
</BaseLayout>
