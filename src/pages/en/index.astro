---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const lang = 'en';

// Fetch projects
const allProjects = await getCollection('projects');
const enProjects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// Fetch articles
const allArticles = await getCollection('articles');
const enArticles = allArticles
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Fetch notes
const allNotes = await getCollection('notes');
const enNotes = allNotes
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={`${profile.name} · ${profile.headline.en}`}
  description={profile.bio.en}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="py-6 sm:py-12 border-b border-base-content/10">
    <div class="flex flex-col gap-5">
      <!-- Status pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-xs font-mono w-fit">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{profile.availability.en}</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-base-content">
          Hi, I'm <span class="text-gradient">{profile.name}</span>.
        </h1>
        <p class="text-lg sm:text-xl font-medium text-primary font-mono">
          {profile.headline.en}
        </p>
      </div>

      <!-- Bio -->
      <p class="text-base text-base-content/80 max-w-2xl leading-relaxed">
        {profile.bio.en}
      </p>

      <!-- CTAs for International Recruiters -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a href="/en/resume" class="btn btn-sm btn-primary gap-2 font-medium shadow-md shadow-primary/20">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          View Interactive Resume
        </a>

        <a href="/en/projects" class="btn btn-sm btn-outline gap-1.5 font-medium">
          Case Studies & Metrics
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href={profile.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5 font-mono text-xs"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>

        <a
          href={`mailto:${profile.email}`}
          class="btn btn-sm btn-ghost gap-1.5 font-mono text-xs"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Skills Matrix -->
  <section class="py-8 border-b border-base-content/10">
    <h2 class="text-xs font-mono uppercase tracking-wider text-base-content/50 mb-4 font-semibold">
      Technical Arsenal & Specializations
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {profile.skills.map((skillGroup) => (
        <div class="glass-panel rounded-lg p-4">
          <h3 class="text-xs font-semibold text-primary mb-2.5">
            {skillGroup.category.en}
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skillGroup.items.map((skill) => (
              <span class={`badge badge-sm font-mono text-[11px] ${skill.highlight ? 'badge-primary badge-soft font-semibold' : 'badge-ghost'}`}>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-10 border-b border-base-content/10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">
          Featured Engineering Case Studies
        </h2>
        <p class="text-xs text-base-content/60 font-mono mt-0.5">
          Proven business impact documented in the STAR framework
        </p>
      </div>
      <a href="/en/projects" class="text-xs font-mono text-primary hover:underline flex items-center gap-1">
        All Projects
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {enProjects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- Two-Column: Deep Dives & Notes -->
  <section class="py-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-base-content">
              Architectural Deep Dives
            </h2>
            <p class="text-xs text-base-content/60 font-mono">
              In-depth articles and technical explorations
            </p>
          </div>
          <a href="/en/blog" class="text-xs font-mono text-primary hover:underline">
            Blog →
          </a>
        </div>

        <div class="flex flex-col gap-4">
          {enArticles.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-base-content">
              Engineering Notes & TIL
            </h2>
            <p class="text-xs text-base-content/60 font-mono">
              Continuous learning and daily code discoveries
            </p>
          </div>
          <a href="/en/notes" class="text-xs font-mono text-primary hover:underline">
            All Notes →
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {enNotes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
