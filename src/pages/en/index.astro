---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const lang = 'en';

// Fetch projects
const allProjects = await getCollection('projects');
const enProjects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// Fetch articles
const allArticles = await getCollection('articles');
const enArticles = allArticles
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Fetch notes
const allNotes = await getCollection('notes');
const enNotes = allNotes
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title={`${profile.name} · ${profile.headline.en}`}
  description={profile.bio.en}
  lang={lang}
>
  <!-- Hero Section (Editorial Minimalist) -->
  <section class="pt-8 sm:pt-16 pb-16 sm:pb-24 border-b border-base-content/10">
    <div class="max-w-3xl space-y-8">
      <!-- Status line -->
      <div class="flex items-center gap-2 text-xs font-mono text-base-content/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>{profile.availability.en}</span>
      </div>

      <!-- Main Headline (No gradients, pure typography) -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-base-content">
          {profile.name}
        </h1>
        <p class="text-base sm:text-lg font-mono text-base-content/70">
          {profile.headline.en}
        </p>
      </div>

      <!-- Bio (Generous breathing room & line height) -->
      <div class="text-base sm:text-lg text-base-content/85 leading-relaxed sm:leading-loose space-y-4">
        <p>
          {profile.bio.en}
        </p>
        <p class="text-sm sm:text-base text-base-content/70">
          Based in Brazil (UTC-3), open to worldwide remote engineering roles.
        </p>
      </div>

      <!-- Action Links -->
      <div class="flex flex-wrap items-center gap-6 pt-4 text-sm font-mono">
        <a href="/en/resume" data-astro-prefetch="viewport" class="btn btn-sm btn-neutral font-medium px-4">
          Read Resume →
        </a>

        <a href="/en/projects" data-astro-prefetch="viewport" class="text-base-content/70 hover:text-base-content hover:underline">
          Case Studies →
        </a>

        <a
          href={profile.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-content/70 hover:text-base-content hover:underline"
        >
          GitHub ↗
        </a>

        <a
          href={`mailto:${profile.email}`}
          class="text-base-content/70 hover:text-base-content hover:underline"
        >
          Email ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Skills Matrix: Pure Text (No boxes, No badges) -->
  <section class="py-16 sm:py-24 border-b border-base-content/10">
    <h2 class="text-xs font-mono uppercase tracking-widest text-base-content/50 mb-10 font-semibold">
      Technical Arsenal
    </h2>

    <div class="space-y-8 max-w-3xl">
      {profile.skills.map((skillGroup) => (
        <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="font-mono text-xs text-base-content/50 uppercase tracking-wider">
            {skillGroup.category.en}
          </span>
          <p class="text-sm sm:text-base text-base-content/85 leading-relaxed">
            {skillGroup.items.map((skill, idx) => (
              <span>
                <span class={skill.highlight ? "text-base-content font-medium" : "text-base-content/75"}>
                  {skill.name}
                </span>
                {idx < skillGroup.items.length - 1 && (
                  <span class="text-base-content/30 mx-2 select-none">·</span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-16 sm:py-24 border-b border-base-content/10">
    <div class="flex items-baseline justify-between mb-10">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-base-content">
          Selected Engineering Cases
        </h2>
        <p class="text-xs font-mono text-base-content/50 mt-1">
          Production systems, architectural decisions, and measured outcomes
        </p>
      </div>

      <a
        href="/en/projects"
        data-astro-prefetch="viewport"
        class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline"
      >
        All projects →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {enProjects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- Writing & Notes -->
  <section class="py-16 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <div class="flex items-baseline justify-between mb-8">
          <div>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-base-content">
              Technical Writing
            </h2>
            <p class="text-xs font-mono text-base-content/50 mt-1">
              Architectural deep dives on Django and modern tooling
            </p>
          </div>
          <a
            href="/en/blog"
            data-astro-prefetch="hover"
            class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline"
          >
            Blog →
          </a>
        </div>

        <div class="space-y-6">
          {enArticles.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between mb-8">
          <div>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-base-content">
              Engineering Notes & TIL
            </h2>
            <p class="text-xs font-mono text-base-content/50 mt-1">
              Daily discoveries and concise reference snippets
            </p>
          </div>
          <a
            href="/en/notes"
            data-astro-prefetch="hover"
            class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline"
          >
            All notes →
          </a>
        </div>

        <div class="divide-y divide-base-content/10 border-t border-base-content/15">
          {enNotes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
