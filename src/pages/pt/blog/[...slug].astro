---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { profile } from '../../../data/profile';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((entry) => entry.data.lang === 'pt')
    .map((entry) => {
      const slug = entry.id.replace(/^(pt\/)/, '').replace(/\.(md|mdx)$/, '');
      return {
        params: { slug },
        props: { entry, slug },
      };
    });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, readingTime, tags, coverImage, coverAlt } = entry.data;

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));
---

<BaseLayout
  title={`${title} · ${profile.name}`}
  description={description}
  lang="pt"
  type="article"
  image={coverImage?.src}
  publishDate={pubDate}
  tags={tags}
>
  <article class="max-w-3xl mx-auto py-6">
    <!-- Back Link -->
    <a
      href="/pt/blog"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-base-content/60 hover:text-primary transition-colors mb-6"
    >
      <span>←</span>
      Voltar para todos os artigos
    </a>

    <!-- Article Header -->
    <header class="border-b border-base-content/10 pb-8 mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-base-content/60 mb-3">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime} de leitura</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content mb-4 leading-tight"
        transition:name={`article-title-${slug}`}
      >
        {title}
      </h1>

      <p class="text-base text-base-content/80 leading-relaxed mb-6">
        {description}
      </p>

      <div class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <span class="badge badge-sm badge-ghost font-mono text-[11px]">
            #{tag}
          </span>
        ))}
      </div>

      {coverImage && (
        <figure class="mt-6 overflow-hidden rounded-lg border border-base-content/15 bg-base-200/40">
          <Image
            src={coverImage}
            alt={coverAlt ?? title}
            width={1200}
            height={630}
            class="w-full h-auto aspect-[16/9] object-cover"
            loading="eager"
            fetchpriority="high"
          />
          {coverAlt && (
            <figcaption class="py-2 px-3 text-center text-xs font-mono text-base-content/60 border-t border-base-content/10">
              — {coverAlt}
            </figcaption>
          )}
        </figure>
      )}
    </header>

    <!-- Markdown Content with Editorial Prose Styles -->
    <div class="prose dark:prose-invert max-w-none
      prose-p:text-base prose-p:leading-[1.8] prose-p:text-base-content/85 prose-p:mb-6
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content
      prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5 prose-h2:pb-2 prose-h2:border-b prose-h2:border-base-content/10
      prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-a:text-primary prose-a:underline-offset-4 hover:prose-a:underline
      prose-code:before:content-none prose-code:after:content-none
      prose-code:font-mono prose-code:text-[0.875em] prose-code:bg-base-200/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
      prose-pre:bg-transparent prose-pre:p-0 prose-pre:border-none prose-pre:my-6
      prose-blockquote:border-l-2 prose-blockquote:border-primary/60 prose-blockquote:italic prose-blockquote:text-base-content/80 prose-blockquote:bg-base-200/25 prose-blockquote:py-1.5 prose-blockquote:px-4 prose-blockquote:rounded-r prose-blockquote:my-6
      prose-ul:my-5 prose-li:my-1.5
      prose-img:rounded-lg prose-img:border prose-img:border-base-content/15 prose-img:my-8">
      <Content />
    </div>

    <!-- Article Author Footer -->
    <footer class="mt-12 pt-8 border-t border-base-content/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-neutral text-neutral-content flex items-center justify-center font-mono font-bold text-base border border-base-content/20">
          M
        </div>
        <div>
          <span class="font-semibold text-sm block">{profile.name}</span>
          <span class="text-xs text-base-content/60 font-mono">{profile.headline.pt}</span>
        </div>
      </div>

      <a
        href={profile.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm btn-outline gap-2 font-medium"
      >
        Discutir artigo no WhatsApp
        <span>→</span>
      </a>
    </footer>
  </article>
</BaseLayout>
