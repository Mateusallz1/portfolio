---
// Página Partiu Parnaíba - Idêntica ao Concept
---

<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Partiu Parnaíba - Contagem Regressiva</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <style>
    @keyframes wave-smooth-1 {
      0% { transform: translateX(0); }
      50% { transform: translateX(-25%); }
      100% { transform: translateX(0); }
    }
    @keyframes wave-smooth-2 {
      0% { transform: translateX(-25%); }
      50% { transform: translateX(0); }
      100% { transform: translateX(-25%); }
    }
    @keyframes palm-wind {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(3deg); }
    }
    .wave-1 {
      animation: wave-smooth-1 9s ease-in-out infinite;
    }
    .wave-2 {
      animation: wave-smooth-2 13s ease-in-out infinite;
    }
    .palm-anim {
      animation: palm-wind 4.5s ease-in-out infinite;
      transform-origin: bottom center;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>
<body class="bg-[#0b0d13] text-slate-100 antialiased p-2 sm:p-4 flex items-center justify-center min-h-[100dvh] m-0">
  
  <div class="w-full max-w-sm sm:max-w-md mx-auto rounded-3xl border border-amber-300/40 dark:border-cyan-500/30 bg-gradient-to-b from-sky-400/10 via-amber-400/5 to-cyan-500/15 shadow-xl relative overflow-hidden backdrop-blur-md">
    
    <!-- Background Glows -->
    <div class="absolute -top-12 -right-12 w-40 h-40 bg-amber-400/20 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -left-10 w-36 h-36 bg-cyan-400/20 rounded-full blur-2xl pointer-events-none"></div>

    <div class="p-3.5 sm:p-6 pb-2 relative">
      
      <!-- Top Row: Teresina Clock & Sound Pill -->
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/80 dark:bg-black/40 border border-slate-200/40 dark:border-white/10 shadow-xs text-[11px] sm:text-xs shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-slate-600 dark:text-slate-400 font-medium">Teresina:</span>
          <span id="clock" class="font-mono font-bold tabular-nums text-cyan-700 dark:text-cyan-300">--:--:--</span>
        </div>

        <button id="audio-toggle" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-[11px] sm:text-xs font-bold text-cyan-800 dark:text-cyan-200 transition-all cursor-pointer active:scale-95 shrink-0 whitespace-nowrap ring-2 ring-cyan-500/40">
          <span id="audio-icon">🔊</span>
          <span id="audio-label">Som Ligado</span>
        </button>
      </div>

      <!-- Destination Header -->
      <div class="mb-3.5">
        <div class="flex items-center gap-1 text-[10px] sm:text-xs font-black tracking-wider uppercase text-amber-700 dark:text-amber-400">
          <span class="palm-anim inline-block text-xs sm:text-sm">🌴</span>
          <span>É DE MANHÃÃÃ</span>
        </div>
        <div class="flex items-baseline justify-between gap-2 mt-0.5">
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white">
            Parnaíba
          </h1>
          <span class="text-[11px] sm:text-xs font-semibold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-md border border-cyan-500/20 whitespace-nowrap shrink-0">
            27 Nov • 08:00
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-snug">
          Tá perto de escutar Ser Tão...
        </p>
      </div>

      <!-- 4-Column Countdown Grid -->
      <div class="grid grid-cols-4 gap-1.5 sm:gap-2.5 mb-3.5">
        
        <!-- Dias -->
        <div class="px-1 py-2 sm:p-3 rounded-2xl bg-white/70 dark:bg-stone-900/60 border border-amber-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden">
          <span class="text-[10px] text-amber-600/80 dark:text-amber-400/80 select-none">☀️</span>
          <div id="days" class="text-lg sm:text-2xl md:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-600 dark:text-slate-400 block leading-tight">
            Dias
          </span>
        </div>

        <!-- Horas -->
        <div class="px-1 py-2 sm:p-3 rounded-2xl bg-white/70 dark:bg-stone-900/60 border border-orange-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden">
          <span class="text-[10px] text-orange-600/80 dark:text-orange-400/80 select-none">🥥</span>
          <div id="hours" class="text-lg sm:text-2xl md:text-3xl font-black text-orange-600 dark:text-orange-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-600 dark:text-slate-400 block leading-tight">
            Horas
          </span>
        </div>

        <!-- Min -->
        <div class="px-1 py-2 sm:p-3 rounded-2xl bg-white/70 dark:bg-stone-900/60 border border-cyan-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden">
          <span class="text-[10px] text-cyan-600/80 dark:text-cyan-400/80 select-none">🏄‍♂️</span>
          <div id="minutes" class="text-lg sm:text-2xl md:text-3xl font-black text-cyan-600 dark:text-cyan-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-600 dark:text-slate-400 block leading-tight">
            Min
          </span>
        </div>

        <!-- Seg -->
        <div class="px-1 py-2 sm:p-3 rounded-2xl bg-white/70 dark:bg-stone-900/60 border border-teal-400/50 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden">
          <span class="text-[10px] text-teal-600/80 dark:text-teal-400/80 select-none">🌊</span>
          <div id="seconds" class="text-lg sm:text-2xl md:text-3xl font-black text-teal-600 dark:text-teal-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-600 dark:text-slate-400 block leading-tight">
            Seg
          </span>
        </div>

      </div>

      <!-- Month Progress Bar -->
      <div class="p-2.5 sm:p-3 rounded-2xl bg-white/50 dark:bg-black/30 border border-slate-200/40 dark:border-white/10 mb-1">
        <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-medium text-slate-600 dark:text-slate-400 mb-1">
          <span>Início de Novembro</span>
          <span id="pct-badge" class="font-mono text-cyan-600 dark:text-cyan-400 font-bold">0%</span>
          <span>Partida (27/11) 🧳</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-black/40 overflow-hidden border border-slate-200/40 dark:border-white/10">
          <div id="progress-fill" class="h-full bg-gradient-to-r from-amber-400 via-teal-400 to-cyan-500 rounded-full transition-all duration-700" style="width: 0%"></div>
        </div>
      </div>

    </div>

    <!-- Waves at Bottom -->
    <div class="relative w-full h-10 overflow-hidden pointer-events-none select-none">
      <div class="absolute bottom-0 left-0 w-[200%] h-8 wave-2 opacity-35 text-cyan-600 dark:text-cyan-800">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M0,0 C200,80 400,-20 600,40 C800,100 1000,20 1200,50 L1200,120 L0,120 Z"></path>
        </svg>
      </div>
      <div class="absolute bottom-0 left-0 w-[200%] h-6 wave-1 opacity-75 text-cyan-400 dark:text-cyan-600">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M0,30 C250,90 450,10 700,60 C950,110 1100,30 1200,70 L1200,120 L0,120 Z"></path>
        </svg>
      </div>
      <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-amber-200 via-amber-300 to-amber-200 border-t border-amber-300/50"></div>
    </div>

  </div>

  <script>
    const target = new Date("2026-11-27T08:00:00-03:00");
    const monthStart = new Date("2026-11-01T00:00:00-03:00");

    const elClock = document.getElementById("clock");
    const elDays = document.getElementById("days");
    const elHours = document.getElementById("hours");
    const elMinutes = document.getElementById("minutes");
    const elSeconds = document.getElementById("seconds");
    const elPctBadge = document.getElementById("pct-badge");
    const elProgressFill = document.getElementById("progress-fill");

    function getTeresinaTime() {
      return new Intl.DateTimeFormat('pt-BR', {
        timeZone: 'America/Fortaleza',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      }).format(new Date());
    }

    function updateTimer() {
      const now = new Date();
      if (elClock) elClock.textContent = getTeresinaTime();

      const diff = target.getTime() - now.getTime();

      if (diff <= 0) {
        if (elDays) elDays.textContent = "00";
        if (elHours) elHours.textContent = "00";
        if (elMinutes) elMinutes.textContent = "00";
        if (elSeconds) elSeconds.textContent = "00";
        if (elPctBadge) elPctBadge.textContent = "100%";
        if (elProgressFill) elProgressFill.style.width = "100%";
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / (3600 * 24));
      const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      const pad = (n) => String(n).padStart(2, '0');
      if (elDays) elDays.textContent = pad(days);
      if (elHours) elHours.textContent = pad(hours);
      if (elMinutes) elMinutes.textContent = pad(minutes);
      if (elSeconds) elSeconds.textContent = pad(seconds);

      const totalSpan = target.getTime() - monthStart.getTime();
      const elapsed = now.getTime() - monthStart.getTime();
      const pct = Math.min(100, Math.max(0, Math.round((elapsed / totalSpan) * 100)));
      if (elPctBadge) elPctBadge.textContent = `${pct}%`;
      if (elProgressFill) elProgressFill.style.width = `${pct}%`;
    }

    updateTimer();
    setInterval(updateTimer, 1000);

    // Audio Waves Synthesizer
    let audioCtx = null;
    let isPlaying = false;
    const btnAudio = document.getElementById("audio-toggle");
    const iconAudio = document.getElementById("audio-icon");
    const labelAudio = document.getElementById("audio-label");

    function startSound() {
      if (isPlaying) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        const bufferLen = audioCtx.sampleRate * 4;
        const buffer = audioCtx.createBuffer(1, bufferLen, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferLen; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;
        noise.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = "lowpass";
        filter.frequency.setValueAtTime(320, audioCtx.currentTime);

        const lfo = audioCtx.createOscillator();
        lfo.frequency.setValueAtTime(0.14, audioCtx.currentTime);
        const lfoGain = audioCtx.createGain();
        lfoGain.gain.setValueAtTime(220, audioCtx.currentTime);
        lfo.connect(filter.frequency);

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        noise.start();
        lfo.start();

        isPlaying = true;
        if (iconAudio) iconAudio.textContent = "🔊";
        if (labelAudio) labelAudio.textContent = "Som Ligado";
        btnAudio?.classList.add("ring-2", "ring-cyan-500/50", "bg-cyan-500/20");
      } catch (_) {}
    }

    function stopSound() {
      if (audioCtx) {
        audioCtx.close();
        audioCtx = null;
      }
      isPlaying = false;
      if (iconAudio) iconAudio.textContent = "🔇";
      if (labelAudio) labelAudio.textContent = "Som Mudo";
      btnAudio?.classList.remove("ring-2", "ring-cyan-500/50", "bg-cyan-500/20");
    }

    btnAudio?.addEventListener("click", () => {
      if (isPlaying) stopSound();
      else startSound();
    });

    window.addEventListener("DOMContentLoaded", startSound);
    document.addEventListener("click", () => {
      if (!isPlaying) startSound();
    }, { once: true });
  </script>
</body>
</html>
