---
// Página Partiu Parnaíba - Layout Completo de Tela Inteira
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR" class="h-full" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Partiu Parnaíba - Contagem Regressiva</title>

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    @keyframes wave-smooth-1 {
      0% { transform: translateX(0); }
      50% { transform: translateX(-25%); }
      100% { transform: translateX(0); }
    }
    @keyframes wave-smooth-2 {
      0% { transform: translateX(-25%); }
      50% { transform: translateX(0); }
      100% { transform: translateX(-25%); }
    }
    @keyframes palm-wind {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(3deg); }
    }
    .wave-1 {
      animation: wave-smooth-1 9s ease-in-out infinite;
    }
    .wave-2 {
      animation: wave-smooth-2 13s ease-in-out infinite;
    }
    .palm-anim {
      animation: palm-wind 4.5s ease-in-out infinite;
      transform-origin: bottom center;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
  </style>
</head>
<body class="h-full min-h-[100dvh] w-full flex flex-col justify-between relative overflow-x-hidden bg-gradient-to-b from-sky-400/15 via-amber-400/10 to-cyan-500/20 text-slate-800 dark:text-slate-100 select-none m-0">
  
  <!-- Background Glows Naturais -->
  <div class="absolute -top-16 -right-16 w-72 h-72 sm:w-96 sm:h-96 bg-amber-400/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-16 -left-16 w-72 h-72 sm:w-96 sm:h-96 bg-cyan-400/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- 1. Topo: Relógio Teresina + Som Ligado em toda a largura -->
  <header class="w-full max-w-5xl mx-auto px-4 sm:px-8 pt-4 sm:pt-6 flex items-center justify-between gap-3 relative z-20">
    <!-- Relógio Oficial de Teresina -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/80 dark:bg-black/50 border border-slate-200/40 dark:border-white/10 shadow-xs text-xs sm:text-sm backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-slate-600 dark:text-slate-400 font-medium">Teresina:</span>
      <span id="clock" class="font-mono font-bold tabular-nums text-cyan-700 dark:text-cyan-300">--:--:--</span>
    </div>

    <!-- Botão Som do Mar Ligado -->
    <button id="audio-toggle" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-xs sm:text-sm font-bold text-cyan-800 dark:text-cyan-200 transition-all cursor-pointer active:scale-95 whitespace-nowrap ring-2 ring-cyan-500/40 backdrop-blur-md">
      <span id="audio-icon">🔊</span>
      <span id="audio-label">Som Ligado</span>
    </button>
  </header>

  <!-- 2. Centro: Contagem ocupando toda a disposição da tela -->
  <main class="w-full max-w-5xl mx-auto px-4 sm:px-8 my-auto py-4 sm:py-8 flex flex-col items-center justify-center text-center relative z-20">
    
    <!-- Cabeçalho -->
    <div class="mb-4 sm:mb-6">
      <div class="flex items-center justify-center gap-1.5 text-xs sm:text-sm font-black tracking-wider uppercase text-amber-700 dark:text-amber-400 mb-1">
        <span class="palm-anim inline-block text-base sm:text-lg">🌴</span>
        <span>É DE MANHÃÃÃ</span>
      </div>
      <div class="flex flex-wrap items-baseline justify-center gap-2 sm:gap-3">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
          Parnaíba
        </h1>
        <span class="text-xs sm:text-sm font-semibold text-cyan-600 dark:text-cyan-400 bg-cyan-500/10 px-3 py-1 rounded-lg border border-cyan-500/25 whitespace-nowrap shadow-xs">
          27 Nov • 08:00
        </span>
      </div>
      <p class="text-xs sm:text-base text-slate-600 dark:text-slate-300 mt-1 max-w-md mx-auto leading-snug">
        Tá perto de escutar Ser Tão...
      </p>
    </div>

    <!-- 4 Cards da Contagem (Expandidos para preencher a largura) -->
    <div class="w-full max-w-4xl grid grid-cols-4 gap-2 sm:gap-4 md:gap-6 mb-5 sm:mb-8">
      
      <!-- Dias -->
      <div class="p-2.5 sm:p-5 md:p-6 rounded-2xl sm:rounded-3xl bg-white/75 dark:bg-stone-900/60 border border-amber-400/40 text-center shadow-md flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm hover:scale-102 transition-transform">
        <span class="text-xs sm:text-base text-amber-600/80 dark:text-amber-400/80 select-none mb-0.5">☀️</span>
        <div id="days" class="text-2xl sm:text-5xl md:text-6xl font-black text-amber-600 dark:text-amber-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
          00
        </div>
        <span class="text-[10px] sm:text-xs md:text-sm font-bold uppercase text-slate-600 dark:text-slate-400 block mt-1">
          Dias
        </span>
      </div>

      <!-- Horas -->
      <div class="p-2.5 sm:p-5 md:p-6 rounded-2xl sm:rounded-3xl bg-white/75 dark:bg-stone-900/60 border border-orange-400/40 text-center shadow-md flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm hover:scale-102 transition-transform">
        <span class="text-xs sm:text-base text-orange-600/80 dark:text-orange-400/80 select-none mb-0.5">🥥</span>
        <div id="hours" class="text-2xl sm:text-5xl md:text-6xl font-black text-orange-600 dark:text-orange-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
          00
        </div>
        <span class="text-[10px] sm:text-xs md:text-sm font-bold uppercase text-slate-600 dark:text-slate-400 block mt-1">
          Horas
        </span>
      </div>

      <!-- Min -->
      <div class="p-2.5 sm:p-5 md:p-6 rounded-2xl sm:rounded-3xl bg-white/75 dark:bg-stone-900/60 border border-cyan-400/40 text-center shadow-md flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm hover:scale-102 transition-transform">
        <span class="text-xs sm:text-base text-cyan-600/80 dark:text-cyan-400/80 select-none mb-0.5">🏄‍♂️</span>
        <div id="minutes" class="text-2xl sm:text-5xl md:text-6xl font-black text-cyan-600 dark:text-cyan-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
          00
        </div>
        <span class="text-[10px] sm:text-xs md:text-sm font-bold uppercase text-slate-600 dark:text-slate-400 block mt-1">
          Min
        </span>
      </div>

      <!-- Seg -->
      <div class="p-2.5 sm:p-5 md:p-6 rounded-2xl sm:rounded-3xl bg-white/75 dark:bg-stone-900/60 border border-teal-400/50 text-center shadow-md flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm hover:scale-102 transition-transform">
        <span class="text-xs sm:text-base text-teal-600/80 dark:text-teal-400/80 select-none mb-0.5">🌊</span>
        <div id="seconds" class="text-2xl sm:text-5xl md:text-6xl font-black text-teal-600 dark:text-teal-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
          00
        </div>
        <span class="text-[10px] sm:text-xs md:text-sm font-bold uppercase text-slate-600 dark:text-slate-400 block mt-1">
          Seg
        </span>
      </div>

    </div>

    <!-- Barra de Progresso do Mês Expandida -->
    <div class="w-full max-w-2xl p-3 sm:p-3.5 rounded-2xl bg-white/60 dark:bg-black/30 border border-slate-200/40 dark:border-white/10 backdrop-blur-sm shadow-xs">
      <div class="flex items-center justify-between text-[11px] sm:text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">
        <span>Início de Novembro</span>
        <span id="pct-badge" class="font-mono text-cyan-600 dark:text-cyan-400 font-bold">0%</span>
        <span>Partida (27/11) 🧳</span>
      </div>
      <div class="w-full h-2 sm:h-2.5 rounded-full bg-slate-200 dark:bg-black/40 overflow-hidden border border-slate-200/40 dark:border-white/10">
        <div id="progress-fill" class="h-full bg-gradient-to-r from-amber-400 via-teal-400 to-cyan-500 rounded-full transition-all duration-700" style="width: 0%"></div>
      </div>
    </div>

  </main>

  <!-- 3. Rodapé: Ondas em Tela Cheia de Ponta a Ponta (100vw) com Areia Dourada -->
  <footer class="relative w-full h-14 sm:h-20 overflow-hidden pointer-events-none select-none z-10">
    <div class="absolute bottom-0 left-0 w-[200%] h-12 sm:h-16 wave-2 opacity-35 text-cyan-600 dark:text-cyan-800">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
        <path d="M0,0 C200,80 400,-20 600,40 C800,100 1000,20 1200,50 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
    <div class="absolute bottom-0 left-0 w-[200%] h-9 sm:h-12 wave-1 opacity-75 text-cyan-400 dark:text-cyan-600">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
        <path d="M0,30 C250,90 450,10 700,60 C950,110 1100,30 1200,70 L1200,120 L0,120 Z"></path>
      </svg>
    </div>
    <div class="absolute bottom-0 left-0 w-full h-2 sm:h-2.5 bg-gradient-to-r from-amber-200 via-amber-300 to-amber-200 border-t border-amber-300/50 shadow-md"></div>
  </footer>

  <script>
    const target = new Date("2026-11-27T08:00:00-03:00");
    const monthStart = new Date("2026-11-01T00:00:00-03:00");

    const elClock = document.getElementById("clock");
    const elDays = document.getElementById("days");
    const elHours = document.getElementById("hours");
    const elMinutes = document.getElementById("minutes");
    const elSeconds = document.getElementById("seconds");
    const elPctBadge = document.getElementById("pct-badge");
    const elProgressFill = document.getElementById("progress-fill");

    function getTeresinaTime() {
      return new Intl.DateTimeFormat('pt-BR', {
        timeZone: 'America/Fortaleza',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      }).format(new Date());
    }

    function updateTimer() {
      const now = new Date();
      if (elClock) elClock.textContent = getTeresinaTime();

      const diff = target.getTime() - now.getTime();

      if (diff <= 0) {
        if (elDays) elDays.textContent = "00";
        if (elHours) elHours.textContent = "00";
        if (elMinutes) elMinutes.textContent = "00";
        if (elSeconds) elSeconds.textContent = "00";
        if (elPctBadge) elPctBadge.textContent = "100%";
        if (elProgressFill) elProgressFill.style.width = "100%";
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / (3600 * 24));
      const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      const pad = (n: number) => String(n).padStart(2, '0');
      if (elDays) elDays.textContent = pad(days);
      if (elHours) elHours.textContent = pad(hours);
      if (elMinutes) elMinutes.textContent = pad(minutes);
      if (elSeconds) elSeconds.textContent = pad(seconds);

      const totalSpan = target.getTime() - monthStart.getTime();
      const elapsed = now.getTime() - monthStart.getTime();
      const pct = Math.min(100, Math.max(0, Math.round((elapsed / totalSpan) * 100)));
      if (elPctBadge) elPctBadge.textContent = `${pct}%`;
      if (elProgressFill) elProgressFill.style.width = `${pct}%`;
    }

    updateTimer();
    setInterval(updateTimer, 1000);

    // Audio Waves Synthesizer
    let audioCtx: AudioContext | null = null;
    let isPlaying = false;
    const btnAudio = document.getElementById("audio-toggle");
    const iconAudio = document.getElementById("audio-icon");
    const labelAudio = document.getElementById("audio-label");

    function startSound() {
      if (isPlaying) return;
      try {
        const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        const bufferLen = audioCtx.sampleRate * 4;
        const buffer = audioCtx.createBuffer(1, bufferLen, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferLen; i++) {
          data[i] = Math.random() * 2 - 1;
        }

        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;
        noise.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = "lowpass";
        filter.frequency.setValueAtTime(320, audioCtx.currentTime);

        const lfo = audioCtx.createOscillator();
        lfo.frequency.setValueAtTime(0.14, audioCtx.currentTime);
        const lfoGain = audioCtx.createGain();
        lfoGain.gain.setValueAtTime(220, audioCtx.currentTime);
        lfo.connect(filter.frequency);

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        noise.start();
        lfo.start();

        isPlaying = true;
        if (iconAudio) iconAudio.textContent = "🔊";
        if (labelAudio) labelAudio.textContent = "Som Ligado";
        btnAudio?.classList.add("ring-2", "ring-cyan-500/50", "bg-cyan-500/20");
      } catch (_) {}
    }

    function stopSound() {
      if (audioCtx) {
        audioCtx.close();
        audioCtx = null;
      }
      isPlaying = false;
      if (iconAudio) iconAudio.textContent = "🔇";
      if (labelAudio) labelAudio.textContent = "Som Mudo";
      btnAudio?.classList.remove("ring-2", "ring-cyan-500/50", "bg-cyan-500/20");
    }

    btnAudio?.addEventListener("click", () => {
      if (isPlaying) stopSound();
      else startSound();
    });

    window.addEventListener("DOMContentLoaded", startSound);
    document.addEventListener("click", () => {
      if (!isPlaying) startSound();
    }, { once: true });
  </script>
</body>
</html>
