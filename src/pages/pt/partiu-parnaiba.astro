---
import '../../styles/global.css';

const title = 'Partiu Parnaíba · Contagem Regressiva';
const description = 'Contagem regressiva oficial para a viagem a Parnaíba - PI. Tá perto de escutar Ser Tão...';
---

<!doctype html>
<html lang="pt" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full min-h-[100dvh] w-full flex flex-col justify-between relative overflow-x-hidden bg-gradient-to-b from-sky-400/15 via-amber-400/10 to-cyan-500/20 text-slate-800 dark:text-slate-100 select-none">
    
    <!-- Background Glows Naturais -->
    <div class="absolute -top-16 -right-16 w-60 h-60 sm:w-80 sm:h-80 bg-amber-400/25 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-16 -left-16 w-60 h-60 sm:w-80 sm:h-80 bg-cyan-400/25 rounded-full blur-3xl pointer-events-none"></div>

    <!-- 1. Topo: Navegação Discreta + Relógio Teresina + Som Ligado -->
    <header class="w-full max-w-4xl mx-auto px-4 sm:px-6 pt-4 sm:pt-6 flex items-center justify-between gap-2 relative z-20">
      
      <!-- Voltar ao Portfólio -->
      <a
        href="/pt"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/70 dark:bg-stone-900/60 hover:bg-white dark:hover:bg-stone-800 border border-slate-300/40 dark:border-white/10 text-xs font-mono text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all backdrop-blur-md shadow-xs active:scale-95 shrink-0"
      >
        <span>←</span>
        <span>Portfólio</span>
      </a>

      <!-- Status Bar: Teresina & Som -->
      <div class="flex items-center gap-2">
        
        <!-- Relógio Oficial de Teresina -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/80 dark:bg-black/50 border border-slate-300/40 dark:border-white/10 shadow-xs text-xs backdrop-blur-md shrink-0">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-slate-500 dark:text-slate-400 font-medium">Teresina:</span>
          <span id="clock" class="font-mono font-bold tabular-nums text-cyan-600 dark:text-cyan-300">--:--:--</span>
        </div>

        <!-- Botão Som Ligado por Padrão -->
        <button
          id="audio-toggle"
          type="button"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-xs font-bold text-cyan-800 dark:text-cyan-200 transition-all cursor-pointer active:scale-95 shrink-0 whitespace-nowrap ring-2 ring-cyan-500/40 backdrop-blur-md"
        >
          <span id="audio-icon">🔊</span>
          <span id="audio-label" class="hidden sm:inline">Som Ligado</span>
        </button>
      </div>
    </header>

    <!-- 2. Centro: Contagem com a identidade visual exata definida -->
    <main class="w-full max-w-xl mx-auto px-4 sm:px-6 my-auto py-4 flex flex-col justify-center relative z-20">
      
      <!-- Cabeçalho de Destino -->
      <div class="mb-4 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-1.5 text-xs sm:text-sm font-black tracking-wider uppercase text-amber-700 dark:text-amber-400 mb-1">
          <span class="palm-anim inline-block text-base">🌴</span>
          <span>É DE MANHÃÃÃ</span>
        </div>

        <div class="flex flex-wrap items-baseline justify-center sm:justify-between gap-2">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
            Parnaíba
          </h1>
          <span class="text-xs sm:text-sm font-semibold text-cyan-700 dark:text-cyan-300 bg-cyan-500/15 px-3 py-1 rounded-lg border border-cyan-500/30 whitespace-nowrap shadow-xs">
            27 Nov • 08:00
          </span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1 leading-snug">
          Tá perto de escutar Ser Tão...
        </p>
      </div>

      <!-- 4 Cards da Contagem (Mesmíssimo estilo e proporção) -->
      <div class="grid grid-cols-4 gap-2 sm:gap-3.5 mb-5">
        
        <!-- Dias -->
        <div class="px-1 py-3 sm:p-4 rounded-2xl bg-white/75 dark:bg-stone-900/60 border border-amber-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm">
          <span class="text-xs sm:text-sm text-amber-600/80 dark:text-amber-400/80 select-none">☀️</span>
          <div id="days" class="text-2xl sm:text-4xl md:text-5xl font-black text-amber-600 dark:text-amber-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 dark:text-slate-400 block mt-1">
            Dias
          </span>
        </div>

        <!-- Horas -->
        <div class="px-1 py-3 sm:p-4 rounded-2xl bg-white/75 dark:bg-stone-900/60 border border-orange-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm">
          <span class="text-xs sm:text-sm text-orange-600/80 dark:text-orange-400/80 select-none">🥥</span>
          <div id="hours" class="text-2xl sm:text-4xl md:text-5xl font-black text-orange-600 dark:text-orange-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 dark:text-slate-400 block mt-1">
            Horas
          </span>
        </div>

        <!-- Min -->
        <div class="px-1 py-3 sm:p-4 rounded-2xl bg-white/75 dark:bg-stone-900/60 border border-cyan-400/40 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm">
          <span class="text-xs sm:text-sm text-cyan-600/80 dark:text-cyan-400/80 select-none">🏄‍♂️</span>
          <div id="minutes" class="text-2xl sm:text-4xl md:text-5xl font-black text-cyan-600 dark:text-cyan-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 dark:text-slate-400 block mt-1">
            Min
          </span>
        </div>

        <!-- Seg -->
        <div class="px-1 py-3 sm:p-4 rounded-2xl bg-white/75 dark:bg-stone-900/60 border border-teal-400/50 text-center shadow-xs flex flex-col items-center justify-center min-w-0 overflow-hidden backdrop-blur-sm">
          <span class="text-xs sm:text-sm text-teal-600/80 dark:text-teal-400/80 select-none">🌊</span>
          <div id="seconds" class="text-2xl sm:text-4xl md:text-5xl font-black text-teal-600 dark:text-teal-400 font-mono tabular-nums tracking-tight my-0.5 leading-none">
            00
          </div>
          <span class="text-[10px] sm:text-xs font-bold uppercase text-slate-500 dark:text-slate-400 block mt-1">
            Seg
          </span>
        </div>

      </div>

      <!-- Barra de Progresso do Mês -->
      <div class="p-3 sm:p-3.5 rounded-2xl bg-white/60 dark:bg-black/30 border border-slate-300/40 dark:border-white/10 backdrop-blur-sm shadow-xs mb-3">
        <div class="flex items-center justify-between text-[11px] sm:text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">
          <span>Início de Novembro</span>
          <span id="pct-badge" class="font-mono text-cyan-600 dark:text-cyan-400 font-bold">0%</span>
          <span>Partida (27/11) 🧳</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-black/40 overflow-hidden border border-slate-300/30 dark:border-white/10">
          <div id="progress-fill" class="h-full bg-gradient-to-r from-amber-400 via-teal-400 to-cyan-500 rounded-full transition-all duration-700" style="width: 0%"></div>
        </div>
      </div>

      <!-- Botões de Compartilhar -->
      <div class="flex items-center justify-center gap-2 mt-1">
        <button
          id="copy-link-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/70 dark:bg-stone-900/60 hover:bg-white dark:hover:bg-stone-800 border border-slate-300/40 dark:border-white/10 text-xs font-semibold text-slate-700 dark:text-slate-200 transition-all cursor-pointer backdrop-blur-sm shadow-xs active:scale-95"
        >
          <span id="copy-icon">📋</span>
          <span id="copy-text">Copiar Link</span>
        </button>

        <a
          id="whatsapp-share-btn"
          href="https://api.whatsapp.com/send?text=Partiu%20Parna%C3%ADba!%20Veja%20a%20contagem%20regressiva%20em%20tempo%20real:%20https://gonzatools.com.br/pt/partiu-parnaiba"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-600/90 hover:bg-emerald-600 text-white text-xs font-semibold transition-all cursor-pointer shadow-xs active:scale-95"
        >
          <span>💬</span>
          <span>WhatsApp</span>
        </a>
      </div>

    </main>

    <!-- 3. Rodapé: Ondas em Tela Cheia de Ponta a Ponta com Faixa de Areia -->
    <footer class="relative w-full h-14 sm:h-20 overflow-hidden pointer-events-none select-none z-10">
      
      <!-- Onda de Fundo -->
      <div class="absolute bottom-0 left-0 w-[200%] h-12 sm:h-16 wave-2 opacity-35 text-cyan-600 dark:text-cyan-800">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M0,0 C200,80 400,-20 600,40 C800,100 1000,20 1200,50 L1200,120 L0,120 Z"></path>
        </svg>
      </div>

      <!-- Onda Frontal com Espuma -->
      <div class="absolute bottom-0 left-0 w-[200%] h-9 sm:h-12 wave-1 opacity-75 text-cyan-400 dark:text-cyan-600">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-full fill-current">
          <path d="M0,30 C250,90 450,10 700,60 C950,110 1100,30 1200,70 L1200,120 L0,120 Z"></path>
        </svg>
      </div>

      <!-- Faixa de Areia Dourada -->
      <div class="absolute bottom-0 left-0 w-full h-2 sm:h-2.5 bg-gradient-to-r from-amber-200 via-amber-300 to-amber-200 border-t border-amber-300/50 shadow-md"></div>
    </footer>

    <style is:global>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      @keyframes wave-smooth-1 {
        0% { transform: translateX(0); }
        50% { transform: translateX(-25%); }
        100% { transform: translateX(0); }
      }
      @keyframes wave-smooth-2 {
        0% { transform: translateX(-25%); }
        50% { transform: translateX(0); }
        100% { transform: translateX(-25%); }
      }
      @keyframes palm-wind {
        0%, 100% { transform: rotate(-2deg); }
        50% { transform: rotate(3deg); }
      }
      .wave-1 {
        animation: wave-smooth-1 9s ease-in-out infinite;
      }
      .wave-2 {
        animation: wave-smooth-2 13s ease-in-out infinite;
      }
      .palm-anim {
        animation: palm-wind 4.5s ease-in-out infinite;
        transform-origin: bottom center;
      }
      .tabular-nums {
        font-variant-numeric: tabular-nums;
      }
    </style>

    <!-- Script de Contagem e Áudio da Praia -->
    <script>
      const target = new Date("2026-11-27T08:00:00-03:00");
      const monthStart = new Date("2026-11-01T00:00:00-03:00");

      const elClock = document.getElementById("clock");
      const elDays = document.getElementById("days");
      const elHours = document.getElementById("hours");
      const elMinutes = document.getElementById("minutes");
      const elSeconds = document.getElementById("seconds");
      const elPctBadge = document.getElementById("pct-badge");
      const elProgressFill = document.getElementById("progress-fill");

      function getTeresinaTime() {
        return new Intl.DateTimeFormat('pt-BR', {
          timeZone: 'America/Fortaleza',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false
        }).format(new Date());
      }

      function update() {
        const now = new Date();
        if (elClock) elClock.textContent = getTeresinaTime();

        const diff = target.getTime() - now.getTime();

        if (diff <= 0) {
          if (elDays) elDays.textContent = "00";
          if (elHours) elHours.textContent = "00";
          if (elMinutes) elMinutes.textContent = "00";
          if (elSeconds) elSeconds.textContent = "00";
          if (elPctBadge) elPctBadge.textContent = "100%";
          if (elProgressFill) elProgressFill.style.width = "100%";
          return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / (3600 * 24));
        const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        const pad = (n: number) => String(n).padStart(2, '0');
        if (elDays) elDays.textContent = pad(days);
        if (elHours) elHours.textContent = pad(hours);
        if (elMinutes) elMinutes.textContent = pad(minutes);
        if (elSeconds) elSeconds.textContent = pad(seconds);

        const totalSpan = target.getTime() - monthStart.getTime();
        const elapsed = now.getTime() - monthStart.getTime();
        const pct = Math.min(100, Math.max(0, Math.round((elapsed / totalSpan) * 100)));
        if (elPctBadge) elPctBadge.textContent = `${pct}%`;
        if (elProgressFill) elProgressFill.style.width = `${pct}%`;
      }

      update();
      setInterval(update, 1000);

      // Sintetizador de Ondas Procedurais
      let audioCtx: AudioContext | null = null;
      let isAudioPlaying = false;
      const btnAudio = document.getElementById("audio-toggle");
      const iconAudio = document.getElementById("audio-icon");
      const labelAudio = document.getElementById("audio-label");

      function startSound() {
        if (isAudioPlaying) return;
        try {
          const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (!audioCtx) audioCtx = new AudioCtxClass();
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }

          const bufferLen = audioCtx.sampleRate * 4;
          const buffer = audioCtx.createBuffer(1, bufferLen, audioCtx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferLen; i++) {
            data[i] = Math.random() * 2 - 1;
          }

          const noise = audioCtx.createBufferSource();
          noise.buffer = buffer;
          noise.loop = true;

          const filter = audioCtx.createBiquadFilter();
          filter.type = "lowpass";
          filter.frequency.setValueAtTime(320, audioCtx.currentTime);

          const lfo = audioCtx.createOscillator();
          lfo.frequency.setValueAtTime(0.14, audioCtx.currentTime);
          const lfoGain = audioCtx.createGain();
          lfoGain.gain.setValueAtTime(220, audioCtx.currentTime);
          lfo.connect(filter.frequency);

          const gain = audioCtx.createGain();
          gain.gain.setValueAtTime(0.12, audioCtx.currentTime);

          noise.connect(filter);
          filter.connect(gain);
          gain.connect(audioCtx.destination);

          noise.start();
          lfo.start();

          isAudioPlaying = true;
          if (iconAudio) iconAudio.textContent = "🔊";
          if (labelAudio) labelAudio.textContent = "Som Ligado";
          btnAudio?.classList.add("ring-2", "ring-cyan-500/50", "bg-cyan-500/30");
        } catch (_) {}
      }

      function stopSound() {
        if (audioCtx) {
          audioCtx.close();
          audioCtx = null;
        }
        isAudioPlaying = false;
        if (iconAudio) iconAudio.textContent = "🔇";
        if (labelAudio) labelAudio.textContent = "Som Mudo";
        btnAudio?.classList.remove("ring-2", "ring-cyan-500/50", "bg-cyan-500/30");
      }

      btnAudio?.addEventListener("click", () => {
        if (isAudioPlaying) stopSound();
        else startSound();
      });

      startSound();
      document.addEventListener("click", () => {
        if (!isAudioPlaying) startSound();
      }, { once: true });

      // Compartilhamento
      const copyBtn = document.getElementById("copy-link-btn");
      const copyText = document.getElementById("copy-text");
      const copyIcon = document.getElementById("copy-icon");
      const whatsappBtn = document.getElementById("whatsapp-share-btn") as HTMLAnchorElement | null;

      if (whatsappBtn && typeof window !== 'undefined') {
        whatsappBtn.href = `https://api.whatsapp.com/send?text=Partiu%20Parna%C3%ADba!%20Veja%20a%20contagem%20regressiva%20em%20tempo%20real:%20${encodeURIComponent(window.location.href)}`;
      }

      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (copyText) copyText.textContent = "Copiado!";
          if (copyIcon) copyIcon.textContent = "✅";
          setTimeout(() => {
            if (copyText) copyText.textContent = "Copiar Link";
            if (copyIcon) copyIcon.textContent = "📋";
          }, 2000);
        } catch (_) {}
      });
    </script>
  </body>
</html>
