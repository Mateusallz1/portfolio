---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const lang = 'pt';

// Fetch projects
const allProjects = await getCollection('projects');
const ptProjects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// Fetch articles
const allArticles = await getCollection('articles');
const ptArticles = allArticles
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Fetch notes (TIL)
const allNotes = await getCollection('notes');
const ptNotes = allNotes
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title={`${profile.name} · ${profile.headline.pt}`}
  description={profile.bio.pt}
  lang={lang}
>
  <!-- Hero Section (Editorial Minimalist) -->
  <section class="pt-8 sm:pt-16 pb-16 sm:pb-24 border-b border-base-content/10">
    <div class="max-w-3xl space-y-8">
      <!-- Status line -->
      <div class="flex items-center gap-2 text-xs font-mono text-base-content/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>{profile.availability.pt}</span>
      </div>

      <!-- Main Headline (No gradients, pure typography) -->
      <div class="space-y-3">
        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-base-content">
          {profile.name}
        </h1>
        <p class="text-base sm:text-lg font-mono text-base-content/70">
          {profile.headline.pt}
        </p>
      </div>

      <!-- Bio (Generous breathing room & line height) -->
      <div class="text-base sm:text-lg text-base-content/85 leading-relaxed sm:leading-loose space-y-4">
        <p>
          {profile.bio.pt}
        </p>
        <p class="text-sm sm:text-base text-base-content/70">
          Baseado em Teresina - PI, com disponibilidade para contratos remotos no Brasil e no exterior.
        </p>
      </div>

      <!-- Action Links (Clean typography, no colored shadows) -->
      <div class="flex flex-wrap items-center gap-6 pt-4 text-sm font-mono">
        <a
          href={profile.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-neutral font-medium px-4"
        >
          Conversar no WhatsApp ↗
        </a>

        <a href="/pt/servicos" class="text-base-content/70 hover:text-base-content hover:underline">
          Serviços & Consultoria →
        </a>

        <a
          href={profile.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-base-content/70 hover:text-base-content hover:underline"
        >
          GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Skills Matrix: Pure Text (No boxes, No badges) -->
  <section class="py-16 sm:py-24 border-b border-base-content/10">
    <h2 class="text-xs font-mono uppercase tracking-widest text-base-content/50 mb-10 font-semibold">
      Stack Tecnológica & Foco
    </h2>

    <div class="space-y-8 max-w-3xl">
      {profile.skills.map((skillGroup) => (
        <div class="grid grid-cols-1 sm:grid-cols-[180px_1fr] gap-2 sm:gap-6 items-baseline">
          <span class="font-mono text-xs text-base-content/50 uppercase tracking-wider">
            {skillGroup.category.pt}
          </span>
          <p class="text-sm sm:text-base text-base-content/85 leading-relaxed">
            {skillGroup.items.map((skill, idx) => (
              <span>
                <span class={skill.highlight ? "text-base-content font-medium" : "text-base-content/75"}>
                  {skill.name}
                </span>
                {idx < skillGroup.items.length - 1 && (
                  <span class="text-base-content/30 mx-2 select-none">·</span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-16 sm:py-24 border-b border-base-content/10">
    <div class="flex items-baseline justify-between mb-10">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-base-content">
          Estudos de Caso Selecionados
        </h2>
        <p class="text-xs font-mono text-base-content/50 mt-1">
          Arquitetura, decisões técnicas e métricas mensuradas
        </p>
      </div>

      <a href="/pt/projetos" class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline">
        Todos os projetos →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {ptProjects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- Writing & Digital Garden -->
  <section class="py-16 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Long-form Articles -->
      <div>
        <div class="flex items-baseline justify-between mb-8">
          <div>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-base-content">
              Artigos Aprofundados
            </h2>
            <p class="text-xs font-mono text-base-content/50 mt-1">
              Deep dives sobre Python, Django e arquitetura
            </p>
          </div>
          <a href="/pt/blog" class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline">
            Blog →
          </a>
        </div>

        <div class="space-y-6">
          {ptArticles.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Quick Notes / TIL -->
      <div>
        <div class="flex items-baseline justify-between mb-8">
          <div>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-base-content">
              Notas & TIL
            </h2>
            <p class="text-xs font-mono text-base-content/50 mt-1">
              Anotações contínuas e snippets práticos
            </p>
          </div>
          <a href="/pt/notas" class="text-xs font-mono text-base-content/60 hover:text-base-content hover:underline">
            Todas as notas →
          </a>
        </div>

        <div class="divide-y divide-base-content/10 border-t border-base-content/15">
          {ptNotes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
