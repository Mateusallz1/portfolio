---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';

const lang = 'pt';

// Fetch projects
const allProjects = await getCollection('projects');
const ptProjects = allProjects
  .filter((p) => p.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

// Fetch articles
const allArticles = await getCollection('articles');
const ptArticles = allArticles
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

// Fetch notes (TIL)
const allNotes = await getCollection('notes');
const ptNotes = allNotes
  .filter((n) => n.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={`${profile.name} · ${profile.headline.pt}`}
  description={profile.bio.pt}
  lang={lang}
>
  <!-- Hero Section (Linear Style) -->
  <section class="py-6 sm:py-12 border-b border-base-content/10">
    <div class="flex flex-col gap-5">
      <!-- Availability pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-xs font-mono w-fit">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{profile.availability.pt}</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-base-content">
          Olá, sou o <span class="text-gradient">{profile.name}</span>.
        </h1>
        <p class="text-lg sm:text-xl font-medium text-primary font-mono">
          {profile.headline.pt}
        </p>
      </div>

      <!-- Bio Paragraphs -->
      <p class="text-base text-base-content/80 max-w-2xl leading-relaxed">
        {profile.bio.pt}
      </p>

      <!-- CTAs (Service & Portfolio) -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={profile.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-primary gap-2 font-medium shadow-md shadow-primary/20"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 2C6.518 2 2.032 6.485 2.032 12.001c0 1.954.561 3.845 1.625 5.467L2 22l4.67-1.611a9.98 9.98 0 005.361 1.612h.004c5.513 0 10-4.486 10-10.002 0-5.516-4.487-10-10.004-10zm0 18.293a8.27 8.27 0 01-4.223-1.157l-.303-.18-3.138 1.082 1.098-3.06-.197-.314a8.274 8.274 0 01-1.267-4.663c0-4.57 3.719-8.288 8.29-8.288 4.57 0 8.289 3.718 8.289 8.288 0 4.57-3.719 8.288-8.289 8.288z"/>
          </svg>
          Falar sobre um Projeto (WhatsApp)
        </a>

        <a href="/pt/servicos" class="btn btn-sm btn-outline gap-1.5 font-medium">
          Ver Serviços e Soluções
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <a
          href={profile.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5 font-mono text-xs"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Skills Matrix -->
  <section class="py-8 border-b border-base-content/10">
    <h2 class="text-xs font-mono uppercase tracking-wider text-base-content/50 mb-4 font-semibold">
      Stack Tecnológica & Especialidades
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {profile.skills.map((skillGroup) => (
        <div class="glass-panel rounded-lg p-4">
          <h3 class="text-xs font-semibold text-primary mb-2.5">
            {skillGroup.category.pt}
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skillGroup.items.map((skill) => (
              <span class={`badge badge-sm font-mono text-[11px] ${skill.highlight ? 'badge-primary badge-soft font-semibold' : 'badge-ghost'}`}>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-10 border-b border-base-content/10">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">
          Estudos de Caso & Projetos
        </h2>
        <p class="text-xs text-base-content/60 font-mono mt-0.5">
          Resultados reais documentados no formato STAR
        </p>
      </div>
      <a href="/pt/projetos" class="text-xs font-mono text-primary hover:underline flex items-center gap-1">
        Ver todos
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {ptProjects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </section>

  <!-- Two-Column: Deep Dives (Blog) & Quick Notes (Garden) -->
  <section class="py-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Deep Dives -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-base-content">
              Artigos Aprofundados
            </h2>
            <p class="text-xs text-base-content/60 font-mono">
              Arquitetura, Django e tooling
            </p>
          </div>
          <a href="/pt/blog" class="text-xs font-mono text-primary hover:underline">
            Blog →
          </a>
        </div>

        <div class="flex flex-col gap-4">
          {ptArticles.map((article) => (
            <ArticleCard article={article} lang={lang} />
          ))}
        </div>
      </div>

      <!-- Quick Notes / TIL -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold tracking-tight text-base-content">
              Notas & TIL (Today I Learned)
            </h2>
            <p class="text-xs text-base-content/60 font-mono">
              Snippets, dicas e aprendizado contínuo
            </p>
          </div>
          <a href="/pt/notas" class="text-xs font-mono text-primary hover:underline">
            Todas →
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {ptNotes.map((note) => (
            <NoteCard note={note} lang={lang} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
