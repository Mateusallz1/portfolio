---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { profile } from '../../../data/profile';
import { MUSIC_TRACKS, toCleanMusicSlug } from '../../../data/musicTracks';

export async function getStaticPaths() {
  const entries = await getCollection(
    'music',
    (entry) => entry.data.lang === 'pt' && !entry.data.draft
  );

  const sortedByTrack = new Map<string, CollectionEntry<'music'>[]>();
  for (const entry of entries) {
    const list = sortedByTrack.get(entry.data.track) ?? [];
    list.push(entry);
    sortedByTrack.set(entry.data.track, list);
  }
  for (const list of sortedByTrack.values()) {
    list.sort((a, b) => a.data.lessonNumber - b.data.lessonNumber);
  }

  return entries.map((entry) => {
    const slug = toCleanMusicSlug(entry.id);
    const sameTrack = sortedByTrack.get(entry.data.track) ?? [];
    const idx = sameTrack.findIndex((item) => item.id === entry.id);
    const prevLesson = idx > 0 ? sameTrack[idx - 1] : null;
    const nextLesson = idx >= 0 && idx < sameTrack.length - 1 ? sameTrack[idx + 1] : null;

    const otherTrackId = entry.data.track === 'contrabaixo' ? 'teoria-musical' : 'contrabaixo';
    const otherTrackList = sortedByTrack.get(otherTrackId) ?? [];
    const otherTrackEntry = otherTrackList[0] ?? null;

    return {
      params: { slug },
      props: { entry, slug, prevLesson, nextLesson, otherTrackEntry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'music'>;
  slug: string;
  prevLesson: CollectionEntry<'music'> | null;
  nextLesson: CollectionEntry<'music'> | null;
  otherTrackEntry: CollectionEntry<'music'> | null;
}

const { entry, slug, prevLesson, nextLesson, otherTrackEntry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  track,
  lessonNumber,
  level,
  instrument,
  tuning,
  practiceTime,
  readingTime,
  tags,
} = entry.data;

const trackMeta = MUSIC_TRACKS[track];
const unitLabel = track === 'contrabaixo' ? 'Aula' : 'Módulo';
const formattedNumber = String(lessonNumber).padStart(2, '0');
const transitionKey = slug.replace(/\//g, '-');

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));
---

<BaseLayout
  title={`${title} · ${trackMeta.title} · ${profile.name}`}
  description={description}
  lang="pt"
  type="article"
  publishDate={pubDate}
  tags={tags}
>
  <article class="max-w-3xl mx-auto py-4 sm:py-6 min-w-0 max-w-full">
    <!-- Back Link -->
    <a
      href="/pt/musica"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-base-content/60 hover:text-primary transition-colors mb-4 sm:mb-6"
    >
      <span aria-hidden="true">←</span>
      Voltar para Trilhas de Música
    </a>

    <!-- Lesson Header -->
    <header class="border-b border-base-content/10 pb-6 sm:pb-8 mb-6 sm:mb-8 min-w-0">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-base-content/60 mb-3">
        <span class="badge badge-sm badge-primary badge-soft font-mono">
          {trackMeta.badge}
        </span>
        <span class="font-bold text-primary">
          {unitLabel} {formattedNumber}
        </span>
        <span>·</span>
        <span>{level}</span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime} de leitura</span>
      </div>

      <h1
        class="text-2xl sm:text-4xl font-extrabold tracking-tight text-base-content mb-3 sm:mb-4 leading-tight break-words"
        transition:name={`music-title-${transitionKey}`}
      >
        {title}
      </h1>

      <p class="text-sm sm:text-base text-base-content/80 leading-relaxed mb-4 sm:mb-6 break-words">
        {description}
      </p>

      {(instrument || tuning || practiceTime) && (
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 p-3.5 rounded-lg bg-base-200/40 border border-base-content/10 mb-4 sm:mb-6 text-xs font-mono">
          {instrument && (
            <div>
              <dt class="text-[10px] uppercase tracking-wider text-base-content/50">Instrumento</dt>
              <dd class="font-semibold text-base-content mt-0.5">{instrument}</dd>
            </div>
          )}
          {tuning && (
            <div>
              <dt class="text-[10px] uppercase tracking-wider text-base-content/50">Afinação</dt>
              <dd class="font-semibold text-base-content mt-0.5">{tuning}</dd>
            </div>
          )}
          {practiceTime && (
            <div>
              <dt class="text-[10px] uppercase tracking-wider text-base-content/50">Prática sugerida</dt>
              <dd class="font-semibold text-base-content mt-0.5">{practiceTime}</dd>
            </div>
          )}
        </dl>
      )}

      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {tags.map((tag) => (
          <span class="badge badge-sm badge-ghost font-mono text-[11px]">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Markdown Content with Editorial Prose Styles -->
    <div class="prose dark:prose-invert max-w-none min-w-0 break-words
      prose-p:text-base prose-p:leading-[1.8] prose-p:text-base-content/85 prose-p:mb-6
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content prose-headings:break-words
      prose-h2:text-xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-5 prose-h2:pb-2 prose-h2:border-b prose-h2:border-base-content/10
      prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-a:text-primary prose-a:underline-offset-4 hover:prose-a:underline prose-a:break-words
      prose-code:before:content-none prose-code:after:content-none
      prose-code:font-mono prose-code:text-[0.875em] prose-code:bg-base-200/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:break-words prose-code:[overflow-wrap:anywhere]
      prose-pre:bg-transparent prose-pre:p-0 prose-pre:border-none prose-pre:my-6 prose-pre:max-w-full prose-pre:overflow-x-auto
      prose-table:block prose-table:max-w-full prose-table:overflow-x-auto
      prose-blockquote:border-l-2 prose-blockquote:border-primary/60 prose-blockquote:italic prose-blockquote:text-base-content/80 prose-blockquote:bg-base-200/25 prose-blockquote:py-1.5 prose-blockquote:px-4 prose-blockquote:rounded-r prose-blockquote:my-6
      prose-ul:my-5 prose-li:my-1.5
      prose-img:rounded-lg prose-img:border prose-img:border-base-content/15 prose-img:my-8 prose-img:max-w-full prose-img:h-auto">
      <Content />
    </div>

    <!-- Sequential Track Footer -->
    <nav aria-label="Aulas da trilha" class="mt-12 pt-8 border-t border-base-content/10 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevLesson ? (
          <a
            href={`/pt/musica/${toCleanMusicSlug(prevLesson.id)}`}
            data-astro-prefetch="hover"
            class="p-4 rounded-xl border border-base-content/15 hover:border-primary/40 bg-base-200/25 transition-colors flex flex-col gap-1"
          >
            <span class="text-[11px] font-mono text-base-content/55">← {unitLabel} anterior</span>
            <span class="text-sm font-semibold text-base-content">{prevLesson.data.title}</span>
          </a>
        ) : (
          <a
            href="/pt/musica"
            data-astro-prefetch="hover"
            class="p-4 rounded-xl border border-base-content/15 hover:border-primary/40 bg-base-200/25 transition-colors flex flex-col gap-1"
          >
            <span class="text-[11px] font-mono text-base-content/55">← Índice</span>
            <span class="text-sm font-semibold text-base-content">Ver todas as trilhas de música</span>
          </a>
        )}

        {nextLesson ? (
          <a
            href={`/pt/musica/${toCleanMusicSlug(nextLesson.id)}`}
            data-astro-prefetch="hover"
            class="p-4 rounded-xl border border-base-content/15 hover:border-primary/40 bg-base-200/25 transition-colors flex flex-col gap-1 sm:text-right"
          >
            <span class="text-[11px] font-mono text-primary">Próxima {unitLabel.toLowerCase()} →</span>
            <span class="text-sm font-semibold text-base-content">{nextLesson.data.title}</span>
          </a>
        ) : otherTrackEntry ? (
          <a
            href={`/pt/musica/${toCleanMusicSlug(otherTrackEntry.id)}`}
            data-astro-prefetch="hover"
            class="p-4 rounded-xl border border-base-content/15 hover:border-primary/40 bg-base-200/25 transition-colors flex flex-col gap-1 sm:text-right"
          >
            <span class="text-[11px] font-mono text-primary">
              Trilha complementar ({MUSIC_TRACKS[otherTrackEntry.data.track].badge}) →
            </span>
            <span class="text-sm font-semibold text-base-content">{otherTrackEntry.data.title}</span>
          </a>
        ) : null}
      </div>
    </nav>

    <!-- Author Footer -->
    <footer class="mt-10 pt-8 border-t border-base-content/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-neutral text-neutral-content flex items-center justify-center font-mono font-bold text-base border border-base-content/20 shrink-0">
          M
        </div>
        <div>
          <span class="font-semibold text-sm block">{profile.name}</span>
          <span class="text-xs text-base-content/60 font-mono">{profile.headline.pt}</span>
        </div>
      </div>

      <a
        href={profile.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm btn-outline gap-2 font-medium w-full sm:w-auto"
      >
        Conversar sobre música ou código
        <span aria-hidden="true">→</span>
      </a>
    </footer>
  </article>
</BaseLayout>
